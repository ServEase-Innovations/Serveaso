# Copy to `.env.local` at the monorepo root — single source for Postgres database name in local dev.
# Start databases: docker compose up -d
#
# Canonical Postgres database name (all services read this via scripts/postgres-env.cjs):
POSTGRES_DB=serveaso1

# Optional full URL (database segment overrides POSTGRES_DB when both are set):
# DATABASE_URL=postgresql://serveaso:serveaso@127.0.0.1:5432/serveaso1

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=serveaso
POSTGRES_PASSWORD=serveaso

# Sequelize services (providers, coupons) also accept DB_NAME — synced from POSTGRES_DB at startup.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=serveaso
DB_PASSWORD=serveaso
DB_NAME=serveaso1

# MongoDB (preferences, utils — separate from Postgres POSTGRES_DB)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# After first-time DB create:
#   npm run db:install && npm run dev:setup
