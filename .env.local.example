# Copy to `.env.local` at the monorepo root — single source for Postgres in local dev.
# Never commit real hosts, passwords, or cloud IPs. Use docker compose for local-only DBs.
#
# Canonical Postgres database name (all services read this via scripts/postgres-env.cjs):
POSTGRES_DB=serveaso1

# Local Postgres (docker compose up -d from monorepo root):
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=serveaso
POSTGRES_PASSWORD=your_postgres_password

# Optional full URL (database segment overrides POSTGRES_DB when both are set):
# DATABASE_URL=postgresql://serveaso:your_postgres_password@127.0.0.1:5432/serveaso1

# Sequelize services (providers, coupons) also accept DB_NAME — synced from POSTGRES_DB at startup.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=serveaso
DB_PASSWORD=your_postgres_password
DB_NAME=serveaso1

# MongoDB (preferences, utils) — local Docker or your private cluster URI in .env.local
MONGO_URI=mongodb://127.0.0.1:27017

# Auth0 Management API — required for utils POST /authO (service provider registration)
# Auth0 Dashboard → Applications → Machine to Machine app → API: Auth0 Management API
# Grant: create:users (and read:users). Use the tenant domain that matches your UI login.
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_MANAGEMENT_CLIENT_ID=
# AUTH0_MANAGEMENT_CLIENT_SECRET=

# After first-time DB create:
#   npm run db:install && npm run dev:setup
