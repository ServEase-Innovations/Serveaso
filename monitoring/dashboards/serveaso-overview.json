{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "up{job=\"serveaso-render-dev\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Scrape targets up",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 2,
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{environment=~\"$metrics_environment\"}[5m]))",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "HTTP request rate by service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (service) (rate(http_requests_total{environment=~\"$metrics_environment\",status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{service}} 5xx",
          "refId": "A"
        }
      ],
      "title": "5xx error rate by service",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_ms_bucket{environment=~\"$metrics_environment\"}[5m])))",
          "legendFormat": "{{service}} p95",
          "refId": "A"
        }
      ],
      "title": "HTTP p95 latency (ms)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 5,
      "targets": [
        {
          "expr": "process_resident_memory_bytes{environment=~\"$metrics_environment\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Process memory (RSS)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 6,
      "targets": [
        {
          "expr": "sum by (service) (rate(socket_io_connections_total{environment=~\"$metrics_environment\"}[5m]))",
          "legendFormat": "{{service}} connects/s",
          "refId": "A"
        }
      ],
      "title": "Socket.IO connections (payments + chat)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 7,
      "targets": [
        {
          "expr": "sum by (service, action, result) (rate(coupon_actions_total{environment=~\"$metrics_environment\"}[5m]))",
          "legendFormat": "{{service}} {{action}} {{result}}",
          "refId": "A"
        }
      ],
      "title": "Coupon actions (coupons service)",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["serveaso", "overview"],
  "templating": {
    "list": [
      {
        "current": { "text": "production", "value": "production" },
        "description": "NODE_ENV on Render DEV is production; set METRICS_ENVIRONMENT=dev on services to use dev here",
        "label": "Metrics environment",
        "name": "metrics_environment",
        "options": [
          { "text": "production", "value": "production", "selected": true },
          { "text": "dev", "value": "dev", "selected": false },
          { "text": "development", "value": "development", "selected": false }
        ],
        "query": "production,dev,development",
        "type": "custom"
      },
      {
        "current": {},
        "hide": 0,
        "label": "Datasource",
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Serveaso — API overview",
  "uid": "serveaso-overview",
  "version": 1
}
