# INTEGRATION_PAYMENTS_URL=https://payments-vyqp.onrender.com
# INTEGRATION_PROVIDERS_URL=https://providers-k8w7.onrender.com
# INTEGRATION_UTILS_URL=https://utils-jo6c.onrender.com
# INTEGRATION_COUPONS_URL=https://coupons-o26r.onrender.com
# INTEGRATION_REVIEWS_URL=https://reviews-7aal.onrender.com
# INTEGRATION_TICKETS_URL=https://tickets-3gc8.onrender.com
# INTEGRATION_PREFERENCES_URL=https://preferences.onrender.com
