# INTEGRATION_IMAGE_UPLOADER_URL=https://imageuploader-5njj.onrender.com

# Live signed webhook test (optional — skips if unset)
# RAZORPAY_WEBHOOK_SECRET=

# DEV smoke fixtures (defaults: customer 1, provider 2)
# INTEGRATION_TEST_CUSTOMER_ID=1
# INTEGRATION_TEST_PROVIDER_ID=2

# Auth bypass when JWT_PROTECT_MUTATIONS=true on DEV (optional)
# INTEGRATION_INTERNAL_SECRET=

# INTEGRATION_TIMEOUT_MS=45000
