{
  "name": "serveaso-be",
  "private": true,
  "description": "Serveaso monorepo — backend microservices (services/*) + React UI (apps/servase-ui)",
  "workspaces": [
    "services/chat",
    "services/coupons",
    "services/imageUploader",
    "services/payments",
    "services/preferences",
    "services/providers",
    "services/reviews",
    "services/tickets",
    "services/utils"
  ],
  "scripts": {
    "db:baseline": "npm run baseline --prefix database",
    "dev:setup": "npm run db:install && npm run db:baseline && npm run db:migrate",
    "predev": "node scripts/predev-migrate.mjs",
    "dev": "concurrently -n pay,pref,prov,coupons,utils,rev,tix,website -c blue,magenta,green,yellow,cyan,red,white,brightBlue \"PORT=4100 npm run dev --workspace=services/payments\" \"PORT=3001 npm run dev --workspace=services/preferences\" \"PORT=4000 npm run dev --workspace=services/providers\" \"PORT=3002 npm run dev --workspace=services/coupons\" \"PORT=3030 UTILS_EMAIL_PORT=4030 npm run dev --workspace=services/utils\" \"PORT=5005 npm run dev --workspace=services/reviews\" \"PORT=5006 npm run dev --workspace=services/tickets\" \"npm run dev:website\"",
    "dev:all": "npm run dev",
    "dev:payments": "PORT=4100 npm run dev --workspace=services/payments",
    "dev:preferences": "npm run dev --workspace=services/preferences",
    "dev:providers": "npm run dev --workspace=services/providers",
    "dev:coupons": "npm run dev --workspace=services/coupons",
    "start:payments": "npm run prod --workspace=services/payments",
    "start:preferences": "npm run start --workspace=services/preferences",
    "start:providers": "npm run start --workspace=services/providers",
    "start:coupons": "npm run start --workspace=services/coupons",
    "dev:utils": "npm run dev --workspace=services/utils",
    "start:utils": "npm run start --workspace=services/utils",
    "dev:reviews": "PORT=5005 npm run dev --workspace=services/reviews",
    "dev:tickets": "PORT=5006 npm run dev --workspace=services/tickets",
    "dev:ui": "npm start --prefix apps/servase-ui",
    "dev:website": "npm run dev --prefix apps/servease-website",
    "db:migrate": "npm run migrate --prefix database",
    "db:migrate:sql": "npm run migrate:sql --prefix database",
    "db:migrate:prisma": "npm run migrate:prisma --prefix database",
    "db:install": "npm install --prefix database",
    "test:integration": "node --test tests/integration/"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pg": "^8.21.0"
  },
  "engines": {
    "node": ">=20"
  }
}
