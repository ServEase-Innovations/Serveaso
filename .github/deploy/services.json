{
  "payments": {
    "label": "Payments",
    "path": "services/payments",
    "ec2_app": "payments",
    "pm2": true,
    "install": "npm ci --omit=dev --legacy-peer-deps",
    "render_secret": "RENDER_DEPLOY_HOOK_PAYMENTS",
    "render_service_id_secret": "RENDER_SERVICE_ID_PAYMENTS"
  },
  "providers": {
    "label": "Providers",
    "path": "services/providers",
    "ec2_app": "providers",
    "docker": true,
    "render_secret": "RENDER_DEPLOY_HOOK_PROVIDERS",
    "render_service_id_secret": "RENDER_SERVICE_ID_PROVIDERS"
  },
  "coupons": {
    "label": "Coupons",
    "path": "services/coupons",
    "ec2_app": "coupons",
    "pm2": true,
    "install": "npm ci --omit=dev && npx prisma generate",
    "render_secret": "RENDER_DEPLOY_HOOK_COUPONS",
    "render_service_id_secret": "RENDER_SERVICE_ID_COUPONS"
  },
  "preferences": {
    "label": "Preferences",
    "path": "services/preferences",
    "ec2_app": "preferences",
    "pm2": true,
    "install": "npm ci --omit=dev",
    "render_secret": "RENDER_DEPLOY_HOOK_PREFERENCES",
    "render_service_id_secret": "RENDER_SERVICE_ID_PREFERENCES"
  },
  "utils": {
    "label": "Utils",
    "path": "services/utils",
    "ec2_app": "utils",
    "pm2": true,
    "install": "npm ci --omit=dev --legacy-peer-deps",
    "render_secret": "RENDER_DEPLOY_HOOK_UTILS",
    "render_service_id_secret": "RENDER_SERVICE_ID_UTILS"
  },
  "reviews": {
    "label": "Reviews",
    "path": "services/reviews",
    "ec2_app": "reviews",
    "pm2": true,
    "install": "npm ci && npm run build",
    "render_secret": "RENDER_DEPLOY_HOOK_REVIEWS",
    "render_service_id_secret": "RENDER_SERVICE_ID_REVIEWS"
  },
  "tickets": {
    "label": "Tickets",
    "path": "services/tickets",
    "ec2_app": "tickets",
    "pm2": true,
    "install": "npm ci --omit=dev && npx prisma generate",
    "render_secret": "RENDER_DEPLOY_HOOK_TICKETS",
    "render_service_id_secret": "RENDER_SERVICE_ID_TICKETS"
  },
  "image-uploader": {
    "label": "Image Uploader",
    "path": "services/imageUploader",
    "ec2_app": "image-uploader",
    "pm2": true,
    "install": "npm ci --omit=dev",
    "render_secret": "RENDER_DEPLOY_HOOK_IMAGE_UPLOADER",
    "render_service_id_secret": "RENDER_SERVICE_ID_IMAGE_UPLOADER"
  },
  "chat": {
    "label": "Chat",
    "path": "services/chat",
    "ec2_app": "chat",
    "pm2": true,
    "pm2_script": "backend/server.js",
    "install": "npm ci --legacy-peer-deps",
    "render_secret": "RENDER_DEPLOY_HOOK_CHAT",
    "render_service_id_secret": "RENDER_SERVICE_ID_CHAT"
  }
}
